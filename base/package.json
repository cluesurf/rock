{
  "name": "@cluesurf/rock-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable demo of @cluesurf/rock",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build:lib": "cd .. && pnpm make",
    "predev": "pnpm build:lib && pnpm fix-spawn-helper",
    "prebuild": "pnpm build:lib && pnpm fix-spawn-helper",
    "prestart": "pnpm fix-spawn-helper",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "fix-spawn-helper": "find ../node_modules -path '*node-pty*/prebuilds/*/spawn-helper' -exec chmod +x {} +",
    "rebuild-native": "pnpm dlx @electron/rebuild -f -w node-pty,better-sqlite3"
  },
  "dependencies": {
    "@cluesurf/rock": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.0.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^32.0.0",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
