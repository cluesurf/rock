#!/bin/bash
# rock — companion CLI for Rock.app.
#
# Thin bash launcher. Execs Rock.app's bundled Electron
# in Node mode (ELECTRON_RUN_AS_NODE=1) so users don't
# need Node installed on their machine. This is the same
# pattern VS Code's `code` CLI uses.
#
# Installed by the Homebrew cask (Casks/rock.rb) which
# symlinks this script to /usr/local/bin/rock. The real
# logic lives in rock.js (compiled from base/call/rock.ts)
# next to this file inside Contents/Resources/.

set -eu

# Resolve the .app's MacOS dir from THIS script's location.
# Inside the bundle: Contents/Resources/rock + Contents/MacOS/Rock.
# Brew symlinks /usr/local/bin/rock → this script, so $0
# is the symlink path — resolve it.
SELF="$0"
# Follow symlinks (macOS bash has no `readlink -f`).
while [ -L "$SELF" ]; do
  target="$(readlink "$SELF")"
  case "$target" in
    /*) SELF="$target" ;;
    *)  SELF="$(dirname "$SELF")/$target" ;;
  esac
done
RESOURCES_DIR="$(cd "$(dirname "$SELF")" && pwd)"
APP_CONTENTS="$(cd "$RESOURCES_DIR/.." && pwd)"
ELECTRON_BIN="$APP_CONTENTS/MacOS/Rock"
CLI_JS="$RESOURCES_DIR/rock.js"

if [ ! -x "$ELECTRON_BIN" ]; then
  echo "rock: bundled Electron not found at $ELECTRON_BIN" >&2
  echo "      (Rock.app may not be installed in /Applications)" >&2
  exit 1
fi
if [ ! -f "$CLI_JS" ]; then
  echo "rock: bundled CLI not found at $CLI_JS" >&2
  exit 1
fi

# ELECTRON_RUN_AS_NODE turns Electron into a plain Node
# interpreter (skips Chromium, skips the GUI). The CLI then
# runs as a normal Node process.
exec env ELECTRON_RUN_AS_NODE=1 "$ELECTRON_BIN" "$CLI_JS" "$@"
