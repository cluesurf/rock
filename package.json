{
  "name": "@cluesurf/rock",
  "description": "A Hackable Terminal ⊡",
  "version": "0.0.3",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./host/index.js",
  "types": "./host/index.d.ts",
  "exports": {
    ".": {
      "types": "./host/index.d.ts",
      "default": "./host/index.js"
    },
    "./base": {
      "types": "./host/base/index.d.ts",
      "default": "./host/base/index.js"
    },
    "./base/*": {
      "types": "./host/base/*.d.ts",
      "default": "./host/base/*.js"
    },
    "./node": {
      "types": "./host/node/index.d.ts",
      "default": "./host/node/index.js"
    },
    "./node/*": {
      "types": "./host/node/*.d.ts",
      "default": "./host/node/*.js"
    },
    "./face": {
      "types": "./host/face/index.d.ts",
      "default": "./host/face/index.js"
    },
    "./face/*": {
      "types": "./host/face/*.d.ts",
      "default": "./host/face/*.js"
    },
    "./desktop": {
      "types": "./host/desktop/index.d.ts",
      "default": "./host/desktop/index.js"
    },
    "./desktop/*": {
      "types": "./host/desktop/*.d.ts",
      "default": "./host/desktop/*.js"
    },
    "./boot": {
      "types": "./host/boot/index.d.ts",
      "default": "./host/boot/index.js"
    },
    "./boot/preload": {
      "types": "./host/boot/preload.d.ts",
      "default": "./host/boot/preload.js"
    },
    "./tailwind/preset.css": "./tailwind/preset.css"
  },
  "files": ["host", "tailwind"],
  "scripts": {
    "make": "rm -rf host && tsc && tsc-alias --resolve-full-paths",
    "make:icons": "bash task/icons.sh",
    "clean": "rm -rf node_modules base/node_modules host base/out base/dist",
    "clean:lock": "rm -rf node_modules base/node_modules host base/out base/dist pnpm-lock.yaml",
    "reset": "pnpm clean:lock && pnpm install",
    "scan": "concurrently --kill-others \"tsc -w\" \"tsc-alias --resolve-full-paths -w\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint --ext .ts,.tsx ./code --fix",
    "dev": "pnpm --filter @cluesurf/rock-base dev",
    "build": "pnpm --filter @cluesurf/rock-base build",
    "start": "pnpm --filter @cluesurf/rock-base start",
    "demo:install": "pnpm --filter @cluesurf/rock-base install",
    "package": "pnpm --filter @cluesurf/rock-base package",
    "package:mac": "pnpm --filter @cluesurf/rock-base package:mac",
    "package:win": "pnpm --filter @cluesurf/rock-base package:win",
    "package:linux": "pnpm --filter @cluesurf/rock-base package:linux",
    "prepublishOnly": "pnpm make && pnpm test",
    "publish:npm": "pnpm publish --access public --no-git-checks",
    "publish:dry": "pnpm publish --access public --dry-run",
    "release:patch": "pnpm version patch && pnpm publish:npm",
    "release:minor": "pnpm version minor && pnpm publish:npm",
    "release:major": "pnpm version major && pnpm publish:npm"
  },
  "peerDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.0.0",
    "electron": ">=42.0.0",
    "esbuild": "^0.28.0",
    "node-pty": "^1.1.0",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@xterm/addon-fit": {
      "optional": true
    },
    "@xterm/addon-search": {
      "optional": true
    },
    "@xterm/addon-web-links": {
      "optional": true
    },
    "@xterm/xterm": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "electron": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "node-pty": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "node-pty"]
  }
}
