{
  "name": "@cluesurf/term-dock",
  "version": "0.1.18",
  "private": true,
  "description": "Term.app — the host shell that loads a user's .tool/term/ config",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./make/main/index.js",
  "scripts": {
    "build:lib": "cd .. && pnpm make",
    "predev": "pnpm setup-env && pnpm build:lib",
    "prebuild": "pnpm setup-env && pnpm build:lib",
    "prestart": "pnpm setup-env && pnpm build:lib",
    "setup-env": "pnpm fix-bins && pnpm fix-spawn-helper && pnpm fix-electron && pnpm fix-native",
    "fix-bins": "find ../node_modules -path '*/bin/*' \\( -name '*.js' -o -name '*.cjs' -o -name '*.mjs' \\) -exec chmod +x {} + 2>/dev/null; true",
    "fix-electron": "for d in ../node_modules/electron ../../../node_modules/electron; do if [ -d \"$d\" ] && [ ! -d \"$d/dist\" ]; then echo \"installing electron at $d\" && (cd \"$d\" && node install.js); fi; done; true",
    "fix-native": "test -f ../node_modules/node-pty/build/Release/pty.node || bash -c 'export SDKROOT=\"$(ls -d /Library/Developer/CommandLineTools/SDKs/MacOSX*.sdk 2>/dev/null | tail -1)\"; pnpm dlx @electron/rebuild --only node-pty'",
    "dev": "electron-vite dev",
    "build": "electron-vite build && pnpm build:cli",
    "build:cli": "esbuild call/term.ts --bundle --platform=node --format=esm --target=node22 --outfile=make/call/term.js --log-level=warning --define:__TERM_VERSION__=\\\"$(node -p \"require('./package.json').version\")\\\"",
    "start": "electron-vite preview",
    "package": "pnpm setup-env && pnpm build && electron-builder",
    "package:mac": "pnpm setup-env && pnpm build && electron-builder --mac",
    "package:win": "pnpm setup-env && pnpm build && electron-builder --win",
    "package:linux": "pnpm setup-env && pnpm build && electron-builder --linux",
    "verify": "bash ../task/verify.sh",
    "fix-spawn-helper": "find ../node_modules -path '*node-pty*/prebuilds/*/spawn-helper' -exec chmod +x {} +",
    "rebuild-native": "bash -c 'export SDKROOT=\"$(ls -d /Library/Developer/CommandLineTools/SDKs/MacOSX*.sdk 2>/dev/null | tail -1)\"; pnpm dlx @electron/rebuild --only node-pty'"
  },
  "dependencies": {
    "@cluesurf/term": "workspace:*",
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "esbuild": "^0.28.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yargs": "^18.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yargs": "^17.0.33",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "42.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "surf.clue.term",
    "productName": "Term",
    "copyright": "Copyright © 2026 ClueSurf",
    "electronVersion": "42.2.0",
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "code/assets"
    },
    "files": [
      "make/**/*",
      "package.json",
      {
        "from": "../node_modules/node-pty",
        "to": "node_modules/node-pty",
        "filter": ["**/*", "!node_modules/**"]
      },
      {
        "from": "../node_modules/better-sqlite3",
        "to": "node_modules/better-sqlite3",
        "filter": ["**/*", "!node_modules/**"]
      },
      {
        "from": "../node_modules/esbuild",
        "to": "node_modules/esbuild",
        "filter": ["**/*", "!node_modules/**"]
      },
      {
        "from": "../node_modules/@esbuild",
        "to": "node_modules/@esbuild",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/esbuild/**/*",
      "node_modules/@esbuild/**/*",
      "**/*.node",
      "**/spawn-helper"
    ],
    "extraResources": [
      { "from": "call/term", "to": "term" },
      { "from": "make/call/term.js", "to": "term.js" },
      { "from": "../code/theme/claude", "to": "themes/claude" }
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "code/assets/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": ["nsis"],
      "icon": "code/assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "code/assets/icon.png",
      "category": "Development"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
